<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= content_for?(:title) ? yield(:title) : "benchmark.fyi" %></title>
    <%= stylesheet_link_tag "application" %>
    <%= csrf_meta_tags %>
  </head>

  <body>
    <header class="masthead">
      <a class="masthead__wordmark" href="/">benchmark<span>.fyi</span></a>
      <a class="masthead__link" href="https://github.com/fastruby/benchmark.fyi" target="_blank" rel="noopener">GitHub</a>
    </header>

    <main class="shell">
      <%= yield %>
    </main>

    <footer class="colophon">
      <div>
        Built by
        <a href="https://github.com/evanphx" target="_blank" rel="noopener">Evan Phoenix</a>.
        Maintained by
        <a href="https://www.fastruby.io" target="_blank" rel="noopener">FastRuby.io</a>.
      </div>
      <div>
        Powered by
        <a href="https://github.com/evanphx/benchmark-ips" target="_blank" rel="noopener">benchmark-ips</a>
      </div>
    </footer>
  </body>
</html>
