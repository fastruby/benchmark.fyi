<% report_url = "#{root_url}#{@report.short_id}" %>

<div class="report">
  <section class="report__head">
    <div class="eyebrow">Shared report</div>
    <% if (environment = report_environment(@report)) %>
      <ul class="report__meta">
        <% if @report.ruby.present? %><li>ruby <%= @report.ruby %></li><% end %>
        <% if @report.os.present? %><li><%= @report.os %></li><% end %>
        <% if @report.arch.present? %><li><%= @report.arch %></li><% end %>
      </ul>
    <% end %>
  </section>

  <table class="results">
    <thead>
      <tr>
        <th class="results__rail"></th>
        <th class="results__name">name</th>
        <% if @report.compare %>
          <th class="results__slower">slower</th>
        <% end %>
        <th class="results__ips">iterations / second</th>
      </tr>
    </thead>
    <tbody>
      <% @report.entries.each do |part| %>
        <% fastest = part["name"] == @fastest["name"] %>
        <tr class="<%= "is-fastest" if fastest %>">
          <td class="results__rail"></td>
          <td class="results__name">
            <span class="results__label"><%= part["name"] %></span>
            <% if fastest %>
              <span class="results__tag">fastest</span>
            <% end %>
          </td>
          <% if @report.compare %>
            <td class="results__slower"><%= times_slower @fastest, part %></td>
          <% end %>
          <td class="results__ips">
            <span class="results__value"><%= format_ips(part["ips"]).strip %></span>
            <span class="results__dev <%= "is-noisy" if stddev_percentage(part) >= 5 %>">
              &plusmn; <%= format_stddev(part).strip %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @note_high_stddev %>
    <aside class="notice">
      <div class="eyebrow">High standard deviation</div>
      <p>
        One or more entries has a fairly high standard deviation. This means that
        the iterations were not very consistent and were subject to effects outside
        the code itself, such as machine load, GC, etc.
      </p>
    </aside>
  <% end %>

  <section class="share">
    <div class="share__link">
      <span class="share__url"><%= report_url %></span>
      <span class="share__hint">Share the link, or paste the block below.</span>
    </div>

    <div class="share__snippet">
      <div class="share__snippet-head">
        <span class="eyebrow">Copy as markdown</span>
        <span class="share__hint">Click the block to select it all</span>
      </div>
      <pre><%= report_markdown(@report, @fastest, report_url) %></pre>
    </div>
  </section>
</div>
