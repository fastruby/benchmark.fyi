{
  "name": "benchmark.fyi",
  "description": "Benchmark results for Ruby and Rails",
  "stack": "heroku-26",
  "scripts": {
    "postdeploy": "bundle exec rails db:schema:load"
  },
  "env": {
    "LANG": {
      "value": "en_US.UTF-8"
    },
    "RACK_ENV": {
      "value": "production"
    },
    "RAILS_ENV": {
      "value": "production"
    },
    "RAILS_LOG_TO_STDOUT": {
      "value": "enabled"
    },
    "RAILS_SERVE_STATIC_FILES": {
      "value": "enabled"
    },
    "SECRET_KEY_BASE": {
      "generator": "secret"
    }
  },
  "formation": {
    "web": {
      "quantity": 1
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/ruby"
    }
  ],
  "environments": {
    "review": {
      "addons": [
        {
          "plan": "heroku-postgresql:essential-0"
        }
      ],
      "formation": {
        "web": {
          "quantity": 1
        }
      }
    }
  }
}
